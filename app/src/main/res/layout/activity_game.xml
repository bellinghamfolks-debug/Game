<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hayatkafeef.game.render.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/a11y_game_canvas"
        android:focusable="true"
        android:importantForAccessibility="yes" />

    <!-- HUD top bar -->
    <LinearLayout
        android:id="@+id/hud_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/hud_top"
        android:padding="14dp">

        <TextView
            android:id="@+id/hud_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hud_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hud_mission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Accessibility action row, visible to TalkBack and to sighted users -->
    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/hud_bottom">

        <Button
            android:id="@+id/a_left"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="◀"
            android:contentDescription="@string/a11y_turn_left" />

        <Button
            android:id="@+id/a_walk"
            style="@style/BigButton"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:text="▲"
            android:contentDescription="@string/a11y_walk" />

        <Button
            android:id="@+id/a_right"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="▶"
            android:contentDescription="@string/a11y_turn_right" />

        <Button
            android:id="@+id/a_describe"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="🔊"
            android:contentDescription="@string/a11y_describe" />

        <Button
            android:id="@+id/a_interact"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="✋"
            android:contentDescription="@string/a11y_interact" />

        <Button
            android:id="@+id/a_nav"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="🧭"
            android:contentDescription="@string/a11y_navigate" />

        <Button
            android:id="@+id/a_hint"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="💡"
            android:contentDescription="@string/a11y_hint" />

        <Button
            android:id="@+id/a_repeat"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="↻"
            android:contentDescription="@string/a11y_repeat" />

        <Button
            android:id="@+id/a_pause"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="⏸"
            android:contentDescription="@string/a11y_pause_game" />

    </LinearLayout>

    <!-- Hazard warning banner: appears for ~1.6 s when a hazard arms -->
    <LinearLayout
        android:id="@+id/hazard_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:background="#CC8E1F1F"
        android:visibility="gone">

        <TextView
            android:id="@+id/hazard_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textColor="@color/white"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/hazard_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="توقف!"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hazard_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Overlay for pause / dialog text -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:background="#D0000000">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <LinearLayout
            android:id="@+id/overlay_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp" />
    </LinearLayout>

</FrameLayout>
