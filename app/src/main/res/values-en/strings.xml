    <string name="vision_pick_title">Pick your vision</string>
    <string name="vision_pick_hint">This changes how the world is rendered. It does not change the story. You can change it later.</string>
    <string name="vision_total">Totally blind</string>
    <string name="vision_total_desc">Black screen. Everything via audio, narration and vibration.</string>
    <string name="vision_low">Severe low vision</string>
    <string name="vision_low_desc">Large shapes and approximate colors only.</string>
    <string name="vision_blur">Blurred vision</string>
    <string name="vision_blur_desc">Everything is blurred. Faces are hard to read.</string>
    <string name="vision_central">Central vision only</string>
    <string name="vision_central_desc">Tiny circle in the middle, the rest is dark.</string>
    <string name="vision_peripheral">Peripheral vision only</string>
    <string name="vision_peripheral_desc">Center is dark, you see the edges only.</string>
    <string name="vision_sighted">Sighted (to feel the contrast)</string>
    <string name="vision_sighted_desc">Full vision. You can also try the audio-only mode from settings.</string>

